<?xml version="1.0" encoding="utf-8"?>
<!-- Облачная копия и перенос на новый телефон: история тренировок и настройки. Журнал диагностики не копируется. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="sessions" />
        <include domain="sharedpref" path="training_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="sessions" />
        <include domain="sharedpref" path="training_settings.xml" />
    </device-transfer>
</data-extraction-rules>
