<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <Button android:id="@+id/btn_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="8dp" android:text="Прогресс и аналитика" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/list_history" android:layout_width="match_parent" android:layout_height="match_parent" android:dividerHeight="1dp" />
        <TextView android:id="@+id/tv_empty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="История пока пуста" android:textSize="18sp" />
    </FrameLayout>
</LinearLayout>
